{
    "audio": "pipewire",
    "bootloader": "limine",
    "keyboard-layout": "uk",
    "custom-mirrors": [
        "https://geo.mirror.pkgbuild.com/$repo/os/$arch",
        "https://mirrors.kernel.org/archlinux/$repo/os/$arch",
        "https://archlinux.uk.mirror.allworldit.com/archlinux/$repo/os/$arch",
        "https://mirror.rackspace.com/archlinux/$repo/os/$arch"
    ],
    "disk_layouts": [
        {
            "device": "/dev/nvme0n1",
            "partitions": [
                {
                    "boot": true,
                    "mountpoint": "/boot",
                    "size": "512MiB",
                    "type": "primary",
                    "filesystem": { "format": "vfat" }
                },
                {
                    "mountpoint": null,
                    "size": "100%",
                    "type": "primary",
                    "filesystem": {
                        "format": "btrfs",
                        "mount_options": ["compress=zstd"],
                        "subvolumes": {
                            "@": "/",
                            "@home": "/home"
                        }
                    }
                }
            ]
        }
    ],
    "packages": [
        "limine",
        "neovim",
        "git",
        "base-devel",
        "networkmanager",
        "pipewire-pulse",
        "pipewire-alsa",
        "wireplumber",
        "alsa-utils",
        "xorg-server",
        "xfce4",
        "xfce4-goodies",
        "xfce4-terminal",
        "lightdm",
        "lightdm-gtk-greeter",
        "epiphany",
        "ttf-liberation",
        "network-manager-applet"
    ],
    "services": [
        "NetworkManager",
        "lightdm"
    ],
    "version": "2.6.1"
}
