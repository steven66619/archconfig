{
  "additional-repositories": [
    "multilib"
  ],
  "audio": {
    "audio": "pipewire"
  },
  "bootloader": "systemd-boot",
  "clock_zone": "Europe/London",
  "config_version": "4.0.0",
  "debug": false,
  "disk_encryption": null,
  "disks": [
    {
      "device": "/dev/nvme0n1",
      "wipe": true,
      "partitions": [
        {
          "boot": true,
          "size": "512MiB",
          "start": "1MiB",
          "type": "primary",
          "filesystem": {
            "format": "vfat",
            "mountpoint": "/boot"
          }
        },
        {
          "size": "100%",
          "start": "513MiB",
          "type": "primary",
          "filesystem": {
            "format": "ext4",
            "mountpoint": "/"
          }
        }
      ]
    }
  ],
  "extraPackages": [
    "xorg-server",
    "lightdm",
    "lightdm-gtk-greeter",
    "xf86-video-amdgpu",
    "mesa",
    "i3-wm",
    "i3lock",
    "i3status",
    "alacritty",
    "picom",
    "dunst",
    "feh",
    "nemo",
    "nemo-fileroller",
    "unzip",
    "unrar",
    "git",
    "neovim",
    "fastfetch",
    "zoxide",
    "fzf",
    "btop",
    "networkmanager",
    "bluez",
    "bluez-utils",
    "blueman",
    "firefox",
    "base-devel",
    "rustup",
    "nodejs",
    "npm",
    "cmake",
    "steam",
    "gamemode"
